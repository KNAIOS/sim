# Local environments and caches; archived evidence is intentionally tracked.
.venv/
venv/
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.DS_Store
Thumbs.db

# Regenerable outputs. Keep the delivered read-only evidence verification report.
/runs/*
!/runs/verification.json

# Never commit machine-specific secrets.
.env
.env.*
!.env.example
*.pem
*.key

